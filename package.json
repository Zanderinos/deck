{
  "name": "deck",
  "version": "0.1.0",
  "description": "AI-native terminal and agent workbench. Summon with Option+Space.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/test.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3 && node scripts/brand-dev-electron.mjs",
    "test:ui": "npm run build && node scripts/ui-smoke.mjs",
    "test:pty": "npm run build && node scripts/pty-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/space-mono": "^5.3.0",
    "@hono/node-server": "^2.1.0",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^5.0.0",
    "hono": "^4.13.0",
    "node-pty": "^1.1.0",
    "react-diff-view": "^3.3.3",
    "react-markdown": "^10.1.0",
    "refractor": "^5.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^37.0.0",
    "electron-vite": "^4.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "electron@37.10.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "node-pty@1.1.0": true,
    "@vscode/ripgrep@1.18.0": true
  }
}
